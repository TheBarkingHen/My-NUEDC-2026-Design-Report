# Ignore everything by default
#*

# --- Blacklist ---

# IDE Autogenerated
.vscode

# LaTeX Compiled Files
*.aux
*.bbl
*.blg
*.dvi
*.fdb_latexmk
*.fls
*.log
*.out
*.pdfsync
*.synctex.gz
*.toc
*.xdv

# Temporary Files
*.auxlock
*.synctex(busy)
*.synctex.gz(busy)
*.synctex(busy.lock)

# Build For Yourselves :P
*.pdf

# --- Whitelist ---
# Keep this .gitignore file
!/.gitignore

# Track the src directory and its contents
!/src/
!/src/*.tex

# Track the pic directory and its contents
!/pic/
!/pic/**

# Track README.md file
!/README.md

# Track the LICENSE file
!/LICENSE
